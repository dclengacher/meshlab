[Unit]
Description=Direwolf APRS TNC (Digirig + FT-65)
After=sound.target

[Service]
User=david
ExecStart=/usr/bin/direwolf -c /home/david/mesh/aprs/direwolf.conf -t 0
StandardOutput=append:/home/david/mesh/aprs/direwolf.log
StandardError=append:/home/david/mesh/aprs/direwolf.log
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
